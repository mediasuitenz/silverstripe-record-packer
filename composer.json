{
    "name": "madecurious/silverstripe-record-packer",
    "description": "Pack up a SilverStripe DataObject (content, owned relations, assets) and move it between installs via the CMS UI.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Andrew Paxley",
            "email": "andrew.paxley@madecurious.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "silverstripe/framework": "^5.4",
        "silverstripe/assets": "^2.3",
        "silverstripe/asset-admin": "^2.4",
        "silverstripe/versioned": "^2.4",
        "symbiote/silverstripe-queuedjobs": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "suggest": {
        "madecurious/silverstripe-page-packer": "Recommended if you need to export/import SiteTree pages — adds the CMSMain page-tree integration built on top of this module, configured specifically for SiteTree."
    },
    "autoload": {
        "psr-4": {
            "MadeCurious\\RecordPacker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadeCurious\\RecordPacker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
